# Every knob MMU reads, with its default. Copy to .env and edit.

# --- paths (absolute or relative to the repo root) ---
# MMU_DATA_DIR=data
# MMU_REPORTS_DIR=reports

# --- embedding ---
# MMU_EMBED_MODEL=BAAI/bge-m3
# cpu by default on purpose: BGE-M3 on the GPU makes Ollama evict the generator every
# request on a 6GB card. See src/mmu/config.py.
# MMU_EMBED_DEVICE=cpu
# MMU_EMBED_BATCH_SIZE=16

# --- chunking ---
# Sized against the GENERATOR's window, not the embedder's: k x max_tokens x 1.3 must
# fit MMU_OLLAMA_NUM_CTX or Ollama left-truncates and the metrics measure truncation.
# MMU_CHUNK_MAX_TOKENS=384
# MMU_CHUNK_MIN_TOKENS=100
# MMU_CHUNK_OVERLAP_TOKENS=64

# --- retrieval ---
# MMU_TOP_K=8
# MMU_DEPTH=            # blank = max(4*top_k, 20)
# MMU_RRF_K=60
# MMU_DENSE_WEIGHT=1.0
# MMU_SPARSE_WEIGHT=1.0
# MMU_SEARCH_CONCURRENCY=     # blank = cpu_count

# --- generation ---
# MMU_GENERATOR_BACKEND=ollama        # ollama | anthropic | gemini
# MMU_OLLAMA_HOST=http://127.0.0.1:11434
# MMU_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# MMU_OLLAMA_FAST_MODEL=llama3.2:3b
# Ollama silently defaults to 2048 and LEFT-truncates past it. Raise this with top_k.
# MMU_OLLAMA_NUM_CTX=4096
# MMU_ANTHROPIC_MODEL=claude-sonnet-5
# MMU_ANTHROPIC_API_KEY=              # requires `uv sync --extra anthropic`
# MMU_TEMPERATURE=0.0
# MMU_MAX_TOKENS=1024

# --- evaluation ---
# MMU_JUDGE_BACKEND=local             # local | ollama | anthropic
# MMU_JUDGE_MODEL=
# MMU_WEIGHT_AF=0.4
# MMU_WEIGHT_CP=0.2
# MMU_WEIGHT_XDR=0.4

# --- gemini (cloud, no extra to install: speaks REST over httpx) ---
# MMU_GENERATOR_BACKEND=gemini
# Pinned, never gemini-flash-latest: a moving alias changes the model under a benchmark
# while every number still looks valid. ListModels advertises models that :generateContent
# refuses, so verify before changing these.
# MMU_GEMINI_MODEL=<...>
# MMU_GEMINI_FAST_MODEL=<...>
# Several keys are a quota strategy, not redundancy: the free tier is limited per key and
# per minute, and a benchmark issues its requests in a burst. Rotation advances on 429.
# MMU_GEMINI_API_KEYS=key1,key2,key3
# Google's own bare names are picked up too, so an .env holding GEMINI_API_KEY or
# GEMINI_API_KEY_1..N works without the MMU_ prefix. See config._discover_gemini_keys.
